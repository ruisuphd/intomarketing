# GCP
GCP_PROJECT_ID=intonation-labs-marketing
# Firebase project for Admin SDK verify_id_token — must match the web app NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Cloud Run: set explicitly if GOOGLE_CLOUD_PROJECT could differ from the Firebase project (deploy workflow sets this from GCP_PROJECT_ID).
# FIREBASE_PROJECT_ID=intonation-labs-marketing
# Firebase token revocation check (1/true default). Set 0 only if logs show flaky revocation checks; weakens revoked-session detection.
# FIREBASE_CHECK_REVOKED=1
GCP_REGION=asia-southeast1
# Latency: Firebase App Hosting may be in asia-east1 while Cloud Run API uses GCP_REGION.
# Cross-region adds RTT on every browser→API call; colocate when your host supports it.
FIRESTORE_DATABASE=(default)

# Cloud Storage bucket
BRAND_DOCS_BUCKET=brand-documents-intonation-labs-marketing
APP_URL=
# Browser → FastAPI origin. Required for `next build` / production; local dev defaults to http://localhost:8080 when unset.
# Example: https://your-api-xxxxx-as.a.run.app (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Must include every browser origin that calls the API (comma-separated). Include all App Hosting hostnames if you use multiple regions.
ALLOWED_ORIGINS=http://localhost:3000

# Vertex AI — Gemini
GEMINI_REGION=global
# Set to 1 to retry marketing_chat / quick_generate on a stable fallback model after primary failures
# GEMINI_ENABLE_MODEL_FALLBACK=1

# Vertex AI — Embeddings
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=2048

# Logging
LOG_LEVEL=INFO

# API: include exception detail in JSON 500 responses (local debugging only; never in production)
# DEBUG_API_ERRORS=1

# Optional closed beta: comma-separated normalized emails. When set, only these accounts can call the API.
# BETA_ALLOWED_EMAILS=founder@company.com,cofounder@company.com

# OAuth (required on Cloud Run / managed runtimes for LinkedIn/X — set Secret Manager secret oauth-state-secret or this env)
# OAUTH_STATE_SECRET=
# LinkedIn app: enable Marketing Developer Platform product; redirect URI = {API}/api/oauth/linkedin/callback
# Scopes include r_organization_social for share analytics (organizationalEntityShareStatistics).
# LINKEDIN_CLIENT_ID= / LINKEDIN_CLIENT_SECRET= (or Firestore system_config oauth_credentials)
# X: tweet.read exposes public_metrics on tweets; impression_count needs a project tier that returns it (Basic may omit).
# X_CLIENT_ID= / X_CLIENT_SECRET=

# Lead enrichment (optional — without it enrichment stays "skipped" in UI)
# Secret Manager: apollo-api-key or:
# APOLLO_API_KEY=

# Newsletter — Beehiiv (tenant can set beehiiv_publication_id via Settings API)
# BEEHIIV_API_KEY= or Secret Manager beehiiv-api-key
# BEEHIIV_PUBLICATION_ID=

# Meta / Instagram (Graph API — app review required)
# META_APP_ID=
# META_APP_SECRET=

# Redis (optional — enables persistent rate limiting and caching)
# REDIS_URL=redis://localhost:6379

# Sentry (optional — set SENTRY_DSN for backend, NEXT_PUBLIC_SENTRY_DSN for frontend)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# SMTP daily digest — platform fallback when a tenant has no per-tenant SMTP doc
# (Per-tenant SMTP is stored at tenants/{tenantId}/tenant_settings/smtp via PUT /api/admin/smtp-config)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Stripe
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Optional: yearly Pro price (~20% off vs 12× monthly). Same product tier as STRIPE_PRO_PRICE_ID.
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Frontend: embedded Pricing Table (Settings → Billing). Use test keys/table in dev; live only in prod.
# Stripe webhooks: POST https://<API_HOST>/webhooks/stripe (or /billing/webhook — same handler).
# Pricing table success/cancel: {APP_URL}/billing?checkout=success | canceled
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=
